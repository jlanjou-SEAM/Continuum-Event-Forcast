ent-section text-center \">\n\t\t<div class=\"download-section \">\n\t\t\t<div class=\"container \">\n\t\t\t\t<div class=\"col-lg-8 col-lg-offset-2 \">\n\t\t\t\t\t<h2 class=\"news\">Social Media</h2>\n\t\t\t\t\t<!--<a href=\"http://startbootstrap.com/template-overviews/grayscale/ \" class=\"btn btn-default btn-lg \">Visit Download Page</a>-->\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</section>\n\n\t<!-- news section -->\n\n\t<section id=\"news\" class=\"content-section text-center \"> </section>\n\t<div class=\"news-section \">\n\t\t<div class=\"container \">\n\t\t\t<div class=\"col-sm-8 col-sm-offset-2\">\n\t\t\t\t<a aria-label=\"Twitter timeline\" class=\"twitter-timeline\" data-width=\"100%\" data-height=\"900\" data-theme=\"dark\" data-link-color=\"#259bdb\" href=\"https://twitter.com/BerkeleySETI\"></a>\n\t\t\t</div>\n\n\t\t</div>\n\n\n\t</div>\n\n\n\n\n\n\t<!-- Contact Section -->\n\n\t<!-- Footer -->\n\t<footer class=\"footer \">\n\t\t<div class=\"container text-center \">\n\t\t\t<div class=\"row \">\n\t\t\t\t<div class=\"col-md-4 col-sm-8 col-md-offset-4 col-sm-offset-2 \">\n\t\t\t\t\t<ul class=\"footer-social-block \">\n                                                <li><a aria-label=\"Facebook\" href=\"https://www.facebook.com/BerkeleySETI/\"><i class=\"fa fa-facebook\" aria-hidden=\"true\" title=\"Facebook\"></i></a></li>\n\n                                                <li><a aria-label=\"Twitter\" href=\"https://twitter.com/BerkeleySETI\"><i class=\"fa fa-twitter\" aria-hidden=\"true\" title=\"Twitter\"></i></a></li>\n\n                                                <li><a aria-label=\"Instagram\" href=\"https://www.instagram.com/setiathome/\"><i class=\"fa fa-instagram\" aria-hidden=\"true\" title=\"Instagram\"></i></a></li>\n\n                                                <li><a aria-label=\"YouTube\" href=\"https://www.youtube.com/user/BerkeleySETI\"><i class=\"fa fa-youtube-play\" aria-hidden=\"true\" title=\"YouTube\"></i></a></li>\n\n\t\